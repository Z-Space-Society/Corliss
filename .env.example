# Corliss — environment template. Copy to `.env` and fill in.
# Placeholders only: NEVER commit real secrets. `.env` is git-ignored.

# --- Core ---------------------------------------------------------------------
# Generate one, e.g.: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=replace-with-a-long-random-string
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1

# Origins trusted for CSRF on POST (Django checks the browser Origin header).
# Required when served behind an HTTPS proxy/tunnel: the browser sends an
# `https://` Origin while the app sees the forwarded request as `http`. To test
# the live atproto login locally, run a tunnel (e.g. `cloudflared tunnel --url
# http://127.0.0.1:8000`), then set this and PUBLIC_BASE_URL to its https origin
# and add the tunnel host to ALLOWED_HOSTS. The atproto auth server must fetch
# client-metadata.json over public HTTPS, so loopback alone can't do atproto login.
CSRF_TRUSTED_ORIGINS=

# Public HTTPS origin this app is served from. Anchors the OAuth client_id, the
# OIDC issuer, and redirect/JWKS URLs. atproto requires this to be public HTTPS
# in production; for local dev use a tunnel or the localhost dev convention.
PUBLIC_BASE_URL=http://localhost:8000

# --- Database (Postgres) ------------------------------------------------------
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/corlissdb

# --- Signing keys (PEM private keys; generate with manage.py generate_keys) ----
# atproto mandates ES256 (P-256) for DPoP + client assertion; the OIDC id_token
# uses RS256. Two keys, both published (public halves) via the JWKS endpoint.
ATPROTO_EC_PRIVATE_KEY_PATH=keys/atproto_ec_private.pem
OIDC_RSA_PRIVATE_KEY_PATH=keys/oidc_rsa_private.pem

# --- OIDC relying party -------------------------------------------------------
OIDC_CLIENT_ID=open-webui
OIDC_CLIENT_SECRET=replace-with-a-shared-secret
OIDC_REDIRECT_URIS=https://chat.example.com/oauth/oidc/callback
# Where to POST a logout_token when a member signs out or is revoked — what makes
# revocation immediate instead of bounded by the RP's own token lifetime. Blank
# disables it (the gate still holds; the old window simply applies). Use the RP's
# INTERNAL address: this is a service-to-service call, not a link a browser follows.
OIDC_BACKCHANNEL_LOGOUT_URI=

# --- UI ------------------------------------------------------------------------
# Public origin of the chat app to link from the nav. Blank hides the link.
CHAT_URL=https://chat.example.com
# Public origin of the cluster's API service, shown on /api/ as the base URL to
# point a client at. Blank leaves that block off the page.
API_URL=https://api.example.com
# Public origin of the Manage Console. Shown in the admin block on the home
# page, to cluster admins only. Blank hides that link.
MANAGE_URL=https://manage.example.com

# --- LiteLLM (the cluster's API service) ------------------------------------
# Where CORLISS reaches LiteLLM, which is not where a member does. Use the
# INTERNAL address: server-side Python cannot fetch our own public origin
# through Cloudflare (Browser Integrity Check refuses it with error 1010), and
# the provisioner key should not cross an edge to reach a neighbouring CT.
# Blank leaves /api/ saying it is not configured, rather than erroring.
LITELLM_URL=http://10.1.1.112:4000
# A `proxy_admin` virtual key, NOT the LiteLLM master key. It can mint and
# delete keys for any member, so keep it to this one place. On the cluster it
# is minted by the zai-ops litellm role; locally, from a dev LiteLLM:
#   curl -s localhost:4000/user/new -H "Authorization: Bearer $MASTER" \
#     -H 'Content-Type: application/json' \
#     -d '{"user_id":"corliss-provisioner","user_role":"proxy_admin","auto_create_key":true}'
LITELLM_PROVISIONER_KEY=
# How many keys one member may hold. LiteLLM enforces no limit of its own.
LITELLM_MAX_KEYS_PER_MEMBER=5

# --- Registry membership push -----------------------------------------------
# Shared bearer token the SCN registry presents when POSTing a grant or
# revocation to /membership/events. Must match CORLISS_PUSH_TOKEN in scn-ops.
# Blank disables the endpoint (503) — it is never open when unconfigured.
# Generate one, e.g.: python -c "import secrets; print(secrets.token_urlsafe(32))"
MEMBERSHIP_PUSH_TOKEN=

# --- Registry admin roster ------------------------------------------------------
# The SCN service DID. Its repo holds the public admin roster record, which
# Corliss reads directly to answer "is this DID an admin?" — no credential, no
# HappyView, no cache in our database, so it still works on a Corliss with an
# empty one. Blank makes every admin check answer "no".
SCN_SERVICE_DID=

# Reading membership back OUT of the registry, which the push cannot do — a
# Corliss rebuilt from nothing has witnessed no pushes, and those events already
# happened. Points at the `syncMembers` service door: read-only, authenticated
# by a shared token rather than a signed-in admin, because the run that matters
# most happens at boot with nobody present. The token is the secret and must
# match RECONCILE_TOKEN in scn-ops. Either of these blank disables
# reconciliation with a visible reason.
MEMBERSHIP_REGISTRY_URL=
MEMBERSHIP_REGISTRY_TOKEN=

# Only needed when the URL above is an INTERNAL address. The registry routes by
# virtual host and answers HTTP 421 "Unknown host" to a request whose Host is a
# bare IP; a reverse proxy normally preserves the public name for you, so
# bypassing the proxy means presenting it yourself. Blank uses the URL's own
# authority, which is what a public-origin deployment wants.
MEMBERSHIP_REGISTRY_HOST=

# Optional. The registry's public `hvc_` client key, sent when set. Verified
# against production: HappyView dispatches to a Lua script with no session and
# no client key, so this is not required — and must not be, or a cluster rebuilt
# before the console's key was configured could not reconcile.
MEMBERSHIP_REGISTRY_CLIENT_KEY=

# --- Local development only -----------------------------------------------------
# Serves /auth/dev-login, which signs you in as ANY handle without authenticating
# anything — a complete auth bypass, for working on the OIDC half and the UI
# without the public HTTPS client_id a real atproto login requires. Requires
# DEBUG=true as well; `manage.py check` fails outright if it is set without it,
# so leave this unset everywhere but your own machine. See the README's
# "Why atproto login can't work over localhost".
DEV_LOGIN_ENABLED=false

# Comma-separated DIDs treated as cluster admins without being on the roster —
# the only way to see the admin surface before the roster record exists. Pair it
# with DEV_LOGIN_ENABLED and use the did:dev: DID your dev sign-in minted, e.g.
# DEV_ADMIN_DIDS=did:dev:you.bsky.social
# Same DEBUG requirement and the same `manage.py check` failure if you forget.
DEV_ADMIN_DIDS=
